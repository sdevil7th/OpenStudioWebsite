{
  "name": "openstudio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate-nam-blog-hero": "node scripts/generate-nam-blog-hero.mjs",
    "sync-blog-images": "node scripts/sync-blog-image-manifest.mjs",
    "generate-image-assets": "node scripts/generate-image-assets.mjs",
    "generate-blog-content": "node scripts/generate-blog-content.mjs",
    "predev": "npm run sync-github-data && npm run stage-release-publish-inputs && npm run validate-release-publish-inputs && npm run generate-download-routing && npm run generate-branding && npm run sync-blog-images && npm run generate-image-assets && npm run generate-blog-content",
    "dev": "vite",
    "stage-release-publish-inputs": "node scripts/stage-release-publish-inputs.mjs",
    "fetch-release-publish-inputs": "node scripts/fetch-release-publish-inputs.mjs",
    "validate-release-publish-inputs": "node scripts/validate-release-publish-inputs.mjs",
    "stage-ai-runtime-metadata": "node scripts/stage-ai-runtime-metadata.mjs",
    "validate-ai-runtime-metadata": "node scripts/validate-ai-runtime-metadata.mjs",
    "validate-launch-readiness": "node scripts/validate-launch-readiness.mjs",
    "prerender-route-metadata": "node scripts/prerender-site.mjs",
    "test:ai-runtime": "node --test test/ai-runtime-manifest.test.mjs",
    "test:launch": "node --test test/launch-readiness.test.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "npm run sync-github-data && npm run stage-release-publish-inputs && npm run validate-release-publish-inputs && npm run generate-download-routing && npm run generate-branding && npm run sync-blog-images && npm run generate-og && npm run generate-blog-content && npm run validate-launch-readiness && npm run typecheck && vite build && npm run prerender-route-metadata",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "verify:mobile-perf": "node scripts/verify-mobile-load-perf.mjs",
    "verify:perf": "node scripts/verify-mobile-load-perf.mjs --matrix --settle-ms 2000",
    "verify:analytics": "node scripts/verify-analytics.mjs",
    "test:mobile-perf-gate": "node --test test/mobile-load-perf-gate.test.mjs",
    "generate-og": "node scripts/generate-og.mjs && npm run generate-image-assets",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "generate-branding": "node scripts/generate-branding.mjs",
    "sync-github-data": "node scripts/sync-github-data.mjs",
    "generate-download-routing": "node scripts/generate-download-routing.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@netlify/functions": "^6.0.0",
    "@netlify/redirect-parser": "^16.1.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-xml-parser": "^5.11.1",
    "globals": "^15.15.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
