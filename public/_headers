# Hashed JS/CSS/image assets - safe to cache 1 year (Vite fingerprints filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML - always revalidate, but retain validators so repeat visits can use 304s
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/**/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Web app manifest has a stable filename and must remain refreshable
/assets/openstudio/branding/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=UTF-8

# Sitemap and robots - refresh daily
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/releases/latest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/releases/stable/latest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/releases/ai-runtime/latest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/releases/ai-runtime/stable/latest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/appcast/windows-stable.xml
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/appcast/macos-stable.xml
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/appcast/linux-stable.xml
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
